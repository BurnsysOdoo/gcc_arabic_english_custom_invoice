<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="custom_striped_layout" inherit_id="web.external_layout_striped">
        <!-- Replace the company address block with custom Arabic/English details and logo after details -->
        <xpath expr="//div[@name='company_address']/ul" position="replace">
            <ul class="list-unstyled" name="company_address_list">
                <li t-if="company.is_company_details_empty">
                    <span t-field="company.partner_id"
                        t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': true}">
                        <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                            <strong>Company address block</strong>
                            <div>Contains the company address.</div>
                        </div>
                    </span>
                </li>
                <li t-else="">
                    <span t-field="company.company_details">
                        <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-left justify-content-left p-4 w-100 opacity-75 text-muted text-center">
                            <strong>Company details block</strong>
                            <div>Contains the company details.</div>
                        </div>
                    </span>
                    <!-- Arabic company details block -->
                    <div dir="rtl" name="company_address_arabic" class="w-30 align-items-right justify-content-right text-right">
                        <ul class="list-unstyled">
                            <li>
                                <t>
                                    <br/> <br/>
                                    <t> شركة إبداع الحمايدي للتجارة</t>,<br/>
                                    <t>الدمام، المملكة العربية السعودية</t>
                                </t>
                            </li>
                            <li t-if="not forced_vat">
                                <t t-if="company.vat">
                                    <t t-esc="'الرقم الضريبي'"></t>:
                                    <span t-esc="company.vat">314490047300003</span>
                                </t>
                            </li>
                        </ul>
                    </div>
                    <!-- Logo after details -->
                    <div class="w-40 align-items-center justify-content-center text-center mt-2">
                        <img t-if="company.logo"
                            class="o_company_logo_big flex-column align-items-right justify-content-right"
                            t-att-src="image_data_uri(company.logo)" alt="Logo" />
                        <div t-if="company.report_header" t-field="company.report_header"
                            class="o_company_tagline fw-bold mt-2">Company tagline</div>
                    </div>
                </li>
                <li t-if="not forced_vat">
                    <t t-if="company.vat">
                        <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>: <span t-esc="company.vat">US12345671</span>
                    </t>
                </li>
                <li t-else="">
                    <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>: <span t-esc="forced_vat">US12345671</span>
                </li>
            </ul>
        </xpath>
    </template>
</odoo>
