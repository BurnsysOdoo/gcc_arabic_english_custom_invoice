<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Custom Header & Footer: Inherited from the standard external layout -->
    <template id="custom_standard_layout" inherit_id="web.external_layout_standard">
        <!-- Customize the Header -->
        <xpath expr="//div[contains(@t-attf-class, 'header o_company_')]" position="replace">
            <div t-attf-class="header o_company_#{company.id}_layout" style="padding: 15px 10px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <!-- English Text on Left -->
                    <div class="english-text" style="flex: 1; text-align: left;">
                        <t t-if="company.name">
                            <h2 class="company-name" style="font-weight: bold; margin:0 0 5px 0;">
                                <t t-esc="company.name"/>
                            </h2>
                        </t>
                        <t t-if="company.partner_id.street or company.partner_id.city or company.partner_id.zip">
                            <p style="margin: 0; font-size: 12px;">
                                <strong>Address:</strong>
                                <t t-esc="company.partner_id.street or ''"/>
                                <t t-if="company.partner_id.city">, <t t-esc="company.partner_id.city"/></t>
                                <t t-if="company.partner_id.zip">, <t t-esc="company.partner_id.zip"/></t>
                            </p>
                        </t>
                        <t t-if="company.partner_id.phone or company.partner_id.email or company.website">
                            <p style="margin: 0; font-size: 12px;">
                                <t t-if="company.partner_id.phone">Phone: <t t-esc="company.partner_id.phone"/> </t>
                                <t t-if="company.partner_id.email">Email: <t t-esc="company.partner_id.email"/> </t>
                                <t t-if="company.website">Website: <t t-esc="company.website"/> </t>
                            </p>
                        </t>
                    </div>
                    <!-- Company Logo in Center -->
                    <div style="flex: 0 0 auto; text-align: center;">
                        <img t-if="company.logo" class="o_company_logo_small" t-att-src="image_data_uri(company.logo)"
                             alt="Company Logo" style="max-height: 60px;"/>
                    </div>
                    <!-- Arabic Text on Right -->
                    <div class="arabic-text" style="flex: 1; text-align: right; direction: rtl;">
                        <t t-if="company.name">
                            <h2 class="company-name" style="font-weight: bold; margin:0 0 5px 0;">
                                شركة <t t-esc="company.name"/>
                            </h2>
                        </t>
                        <!-- Add Arabic address if available, or keep minimal -->
                        <p style="margin: 0; font-size: 12px;">
                            <!-- Arabic contact info -->
                        </p>
                    </div>
                </div>
                <!-- Divider -->
                <div style="border-bottom: 1px solid #bbb; margin-top: 10px;"></div>
            </div>
        </xpath>
        <!-- Customize the Footer -->
        <xpath expr="//div[contains(@class, 'o_footer')]" position="replace">
            <div class="custom_footer text-center" style="border-top: 1px solid #333; padding: 10px 0; font-size: 11px;">
                <!-- Company Name and Page Number -->
                <div class="row mb-1">
                    <div class="col-6 text-start">
                        <strong><t t-esc="company.name"/></strong>
                    </div>
                    <div class="col-6 text-end">
                        Page: <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
                <!-- Company Address -->
                <div class="row">
                    <div class="col-12 text-center">
                        <p style="margin:0;">
                            <t t-esc="company.partner_id.street or ''"/>
                            <t t-if="company.partner_id.city">, <t t-esc="company.partner_id.city"/></t>
                            <t t-if="company.partner_id.country_id">, <t t-esc="company.partner_id.country_id.name"/></t>
                        </p>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="report_invoice_document">
        <t t-call="web.html_container">
            <t t-set="o" t-value="o"/>
            <div class="invoice-report-itax">
                <!-- HEADER -->
                <div class="invoice-header">
                    <div class="company-info-en">
                        <h1><t t-out="o.company_id.name"/></h1>
                        <p><t t-out="o.company_id.street"/></p>
                        <p>VAT: <t t-out="o.company_id.vat"/></p>
                    </div>
                    <div class="company-info-ar">
                        <h1 class="arabic-text">شركة</h1>
                        <p class="arabic-text"><t t-out="o.company_id.name"/></p>
                    </div>
                </div>

                <!-- INVOICE TITLE -->
                <div class="invoice-title">
                    <h2>Tax Invoice</h2>
                    <h2 class="arabic-text">فاتورة ضريبية</h2>
                </div>

                <!-- INVOICE NUMBER & DATES -->
                <div class="invoice-details">
                    <table class="table-details">
                        <tr>
                            <td><strong>Invoice #:</strong></td>
                            <td><t t-out="o.name"/></td>
                            <td class="arabic-text"><strong>رقم الفاتورة:</strong></td>
                            <td><t t-out="o.name"/></td>
                        </tr>
                        <tr>
                            <td><strong>Invoice Date:</strong></td>
                            <td><t t-out="o.invoice_date.strftime('%Y-%m-%d')"/></td>
                            <td class="arabic-text"><strong>تاريخ الفاتورة:</strong></td>
                            <td><t t-out="o.invoice_date.strftime('%Y-%m-%d')"/></td>
                        </tr>
                        <tr>
                            <td><strong>Due Date:</strong></td>
                            <td><t t-out="o.invoice_date_due.strftime('%Y-%m-%d') if o.invoice_date_due else ''"/></td>
                            <td class="arabic-text"><strong>تاريخ الاستحقاق:</strong></td>
                            <td><t t-out="o.invoice_date_due.strftime('%Y-%m-%d') if o.invoice_date_due else ''"/></td>
                        </tr>
                    </table>
                </div>

                <!-- CUSTOMER INFO -->
                <div class="customer-info">
                    <div class="customer-en">
                        <h4>Bill To:</h4>
                        <p><t t-out="o.partner_id.name"/></p>
                        <p><t t-out="o.partner_id.street or ''"/></p>
                        <p>VAT: <t t-out="o.partner_id.vat or 'N/A'"/></p>
                    </div>
                    <div class="customer-ar">
                        <h4 class="arabic-text">إلى:</h4>
                        <p class="arabic-text"><t t-out="o.partner_id.name"/></p>
                    </div>
                </div>

                <!-- LINE ITEMS TABLE -->
                <div class="invoice-lines">
                    <table class="table-lines">
                        <thead>
                            <tr>
                                <th>Description</th>
                                <th>الوصف</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="o.invoice_line_ids" t-as="line">
                                <t t-if="not line.display_type">
                                    <tr>
                                        <td><t t-out="line.name"/></td>
                                        <td class="arabic-text"><!-- Arabic description if available --></td>
                                        <td><t t-out="line.quantity"/></td>
                                        <td><t t-out="'{:,.2f}'.format(line.price_unit)"/></td>
                                        <td><t t-out="'{:,.2f}'.format(line.price_subtotal)"/> SAR</td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>

                <!-- TOTALS SECTION -->
                <div class="invoice-totals">
                    <div class="totals-table">
                        <div class="row">
                            <span>Subtotal (Ex. VAT):</span>
                            <span><t t-out="'{:,.2f}'.format(o.amount_untaxed)"/> SAR</span>
                            <span class="arabic-text">الإجمالي (بدون ضريبة):</span>
                        </div>
                        <div class="row">
                            <span>VAT (15%):</span>
                            <span><t t-out="'{:,.2f}'.format(o.amount_tax)"/> SAR</span>
                            <span class="arabic-text">ضريبة القيمة المضافة (15%):</span>
                        </div>
                        <div class="row total">
                            <strong>Total (Inc. VAT):</strong>
                            <strong><t t-out="'{:,.2f}'.format(o.amount_total)"/> SAR</strong>
                            <strong class="arabic-text">الإجمالي (شاملاً الضريبة):</strong>
                        </div>
                    </div>
                </div>

                <!-- FOOTER -->
                <div class="invoice-footer">
                    <p>Email: <t t-out="o.company_id.email or 'info@company.com'"/></p>
                    <p>Phone: <t t-out="o.company_id.phone or ''"/></p>
                    <p class="arabic-text">البريد الإلكتروني والهاتف</p>
                </div>
            </div>
        </t>
    </template>
</odoo>