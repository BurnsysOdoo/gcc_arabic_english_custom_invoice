<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="gcc_invoice_template" name="GCC Tax Invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page gcc-invoice-page">
                        <!-- HEADER SECTION -->
                        <div class="invoice-header">
                            <div class="row">
                                <div class="col-6">
                                    <h2 class="invoice-title">
                                        <span class="english-text">Tax Invoice</span>
                                        <br/>
                                        <span class="arabic-text">فاتورة ضريبية</span>
                                    </h2>
                                </div>
                                <div class="col-6 text-right">
                                    <h1 class="invoice-number">
                                        <t t-esc="doc.name"/>
                                    </h1>
                                </div>
                            </div>
                        </div>

                        <!-- COMPANY INFO SECTION -->
                        <div class="company-info">
                            <div class="row">
                                <div class="col-6">
                                    <p><strong class="english-text">From:</strong></p>
                                    <p class="company-name">
                                        <t t-esc="doc.company_id.name"/>
                                    </p>
                                    <p>
                                        <t t-esc="doc.company_id.partner_id.street"/>
                                    </p>
                                    <p>
                                        <t t-if="doc.company_id.partner_id.city">
                                            <t t-esc="doc.company_id.partner_id.city"/>,
                                            <t t-esc="doc.company_id.partner_id.state_id.name"/>
                                            <t t-esc="doc.company_id.partner_id.zip"/>
                                        </t>
                                    </p>
                                    <p>
                                        <strong>VAT:</strong>
                                        <t t-esc="doc.company_id.vat or 'N/A'"/>
                                    </p>
                                    <p>
                                        <strong>CRN:</strong>
                                        <t t-esc="doc.company_id.company_registry or 'N/A'"/>
                                    </p>
                                </div>
                                <div class="col-6 text-right">
                                    <p><strong class="arabic-text">إلى:</strong></p>
                                    <p class="customer-name">
                                        <t t-esc="doc.partner_id.name"/>
                                    </p>
                                    <p>
                                        <t t-esc="doc.partner_id.street"/>
                                    </p>
                                    <p>
                                        <t t-if="doc.partner_id.city">
                                            <t t-esc="doc.partner_id.city"/>,
                                            <t t-esc="doc.partner_id.state_id.name"/>
                                            <t t-esc="doc.partner_id.zip"/>
                                        </t>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- INVOICE DATES -->
                        <div class="invoice-dates">
                            <div class="row">
                                <div class="col-3">
                                    <p><strong>Invoice Date:</strong></p>
                                    <p>
                                        <t t-esc="doc.invoice_date.strftime('%Y-%m-%d') if doc.invoice_date else 'N/A'"/>
                                    </p>
                                </div>
                                <div class="col-3">
                                    <p><strong>Supply Date:</strong></p>
                                    <p>
                                        <t t-esc="doc.date.strftime('%Y-%m-%d') if doc.date else 'N/A'"/>
                                    </p>
                                </div>
                                <div class="col-3">
                                    <p><strong>Due Date:</strong></p>
                                    <p>
                                        <t t-esc="doc.invoice_due_date.strftime('%Y-%m-%d') if doc.invoice_due_date else 'N/A'"/>
                                    </p>
                                </div>
                                <div class="col-3 text-right">
                                    <p><strong class="arabic-text">رقم المرجع:</strong></p>
                                    <p>
                                        <t t-esc="doc.ref or 'N/A'"/>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- ITEMS TABLE -->
                        <table class="invoice-items-table">
                            <thead>
                                <tr class="table-header">
                                    <th class="col-item-code">Item Code</th>
                                    <th class="col-description">Description</th>
                                    <th class="col-quantity">Qty</th>
                                    <th class="col-unit-price">Unit Price</th>
                                    <th class="col-line-total">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <tr>
                                        <td class="col-item-code">
                                            <t t-esc="line.product_id.default_code or 'N/A'"/>
                                        </td>
                                        <td class="col-description">
                                            <t t-esc="line.product_id.name or line.name"/>
                                        </td>
                                        <td class="col-quantity text-right">
                                            <t t-esc="'{:.2f}'.format(line.quantity)"/>
                                        </td>
                                        <td class="col-unit-price text-right">
                                            <t t-esc="'{:.2f}'.format(line.price_unit)"/>
                                            <span class="currency">
                                                <t t-esc="doc.currency_id.symbol"/>
                                            </span>
                                        </td>
                                        <td class="col-line-total text-right">
                                            <t t-esc="'{:.2f}'.format(line.price_subtotal)"/>
                                            <span class="currency">
                                                <t t-esc="doc.currency_id.symbol"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- TOTALS SECTION -->
                        <div class="totals-section">
                            <div class="row">
                                <div class="col-6"></div>
                                <div class="col-6">
                                    <table class="totals-table">
                                        <tr class="subtotal-row">
                                            <td class="label">Subtotal (Exclusive of VAT):</td>
                                            <td class="amount text-right">
                                                <t t-esc="'{:.2f}'.format(doc.amount_untaxed)"/>
                                                <span class="currency">
                                                    <t t-esc="doc.currency_id.symbol"/>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr class="tax-row" t-foreach="doc.tax_line_ids" t-as="tax">
                                            <td class="label">
                                                <t t-esc="tax.tax_id.name"/> (<t t-esc="'{:.1f}'.format(tax.tax_id.amount)"/>%):
                                            </td>
                                            <td class="amount text-right">
                                                <t t-esc="'{:.2f}'.format(tax.amount_total)"/>
                                                <span class="currency">
                                                    <t t-esc="doc.currency_id.symbol"/>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr class="total-row">
                                            <td class="label">
                                                <strong>Invoice Total (Inclusive of VAT):</strong>
                                            </td>
                                            <td class="amount text-right">
                                                <strong>
                                                    <t t-esc="'{:.2f}'.format(doc.amount_total)"/>
                                                    <span class="currency">
                                                        <t t-esc="doc.currency_id.symbol"/>
                                                    </span>
                                                </strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- FOOTER SECTION -->
                        <div class="invoice-footer">
                            <div class="row">
                                <div class="col-6">
                                    <p><strong>Payment Terms:</strong></p>
                                    <p class="payment-terms">
                                        <t t-esc="doc.payment_term_id.name if doc.payment_term_id else 'Net 30 days'"/>
                                    </p>
                                </div>
                                <div class="col-6 text-right">
                                    <p><strong class="arabic-text">ملاحظات:</strong></p>
                                    <p class="notes">
                                        <t t-esc="doc.narration or ''"/>
                                    </p>
                                </div>
                            </div>
                            <hr class="footer-divider"/>
                            <div class="company-contact">
                                <p>
                                    <t t-esc="doc.company_id.partner_id.email"/> | 
                                    <t t-esc="doc.company_id.partner_id.phone"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>